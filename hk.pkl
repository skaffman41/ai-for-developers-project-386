amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
    steps {
      ["lint"] {
        check = "mise run lint"
      }
      ["format"] {
        check = "mise run format:check"
      }
    }
  }
}
