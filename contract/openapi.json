{
  "openapi": "3.1.0",
  "info": {
    "title": "Календарь звонков — HTTP API",
    "version": "1.0.0",
    "description": "Работающие операции. Новые операции добавляются вместе с реализацией."
  },
  "tags": [],
  "paths": {
    "/api/availability": {
      "get": {
        "operationId": "getAvailability",
        "summary": "Получить свободные интервалы по московскому времени",
        "description": "Сегодня и следующие 13 московских дней; будни 09:00–18:00, начала через 30 минут строго после asOf. Чтение не резервирует время.",
        "parameters": [
          {
            "name": "eventTypeId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1 },
            "explode": false
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Complete available intervals and authoritative Moscow calendar boundaries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "404": {
            "description": "Unknown event type",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "422": {
            "description": "Invalid date or outside availability horizon",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "post": {
        "operationId": "createBooking",
        "summary": "Подтвердить бронирование с безопасным повтором",
        "description": "Idempotency-Key — UUID. Сравниваются исходные значения JSON, порядок свойств незначим. Структурные ошибки parseable JSON с действительным ключом сохраняются как окончательный VALIDATION_ERROR. Нормализация trim явная, длина проверяется после неё. Переполненные при разборе JSON числа (например 1e400) нельзя интерпретировать: INVALID_REQUEST/unknown до регистрации попытки. rejected возвращается только после commit; технический сбой оставляет unknown. Результаты не имеют TTL.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "201": {
            "description": "Saved result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreatedBooking" }
              }
            }
          },
          "400": {
            "description": "Uninterpretable request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WriteError400" }
              }
            }
          },
          "404": {
            "description": "Saved result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookingError404" }
              }
            }
          },
          "409": {
            "description": "Saved slot conflict or unknown reused key",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookingError409" }
              }
            }
          },
          "422": {
            "description": "Saved result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookingError422" }
              }
            }
          },
          "500": {
            "description": "Unknown technical outcome",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WriteError500" }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable; unknown outcome",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WriteError503" }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateBookingInput" }
            }
          }
        }
      }
    },
    "/api/event-types": {
      "get": {
        "operationId": "getEventTypes",
        "summary": "Получить типы встреч, новые первыми",
        "description": "Порядок: время создания по убыванию, затем монотонный номер создания по убыванию. Названия могут совпадать; displayCode устойчив и уникален.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "All meeting types, including an empty list",
            "headers": {
              "X-Server-Time": {
                "required": true,
                "description": "Authoritative UTC server time of this successful read. Owner classification and last successful-load display use this instant; refresh explicitly to update it.",
                "schema": { "$ref": "#/components/schemas/UtcInstant" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventTypes" }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createEventType",
        "summary": "Создать тип встречи с сохранённым результатом попытки",
        "description": "Idempotency-Key — UUID. Сравниваются исходные значения JSON, порядок свойств незначим. Структурные ошибки parseable JSON с действительным ключом сохраняются как окончательный VALIDATION_ERROR. Нормализация trim явная, длина проверяется после неё. Переполненные при разборе JSON числа (например 1e400) нельзя интерпретировать: INVALID_REQUEST/unknown до регистрации попытки. rejected возвращается только после commit; технический сбой оставляет unknown. Результаты не имеют TTL.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "201": {
            "description": "Created or saved successful result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreatedEventType" }
              }
            }
          },
          "400": {
            "description": "Uninterpretable request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WriteError400" }
              }
            }
          },
          "409": {
            "description": "Key reused with different original data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WriteError409" }
              }
            }
          },
          "422": {
            "description": "Saved validation refusal",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WriteError422" }
              }
            }
          },
          "500": {
            "description": "Unknown technical outcome",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WriteError500" }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable; unknown outcome",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WriteError503" }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateEventTypeInput" }
            }
          }
        }
      }
    },
    "/api/owner/bookings": {
      "get": {
        "operationId": "getOwnerBookings",
        "summary": "Бронирования владельца календаря",
        "description": "Whole saved history, independent of the guest horizon. Default upcoming: endsAt > X-Server-Time, ascending startsAt. past: endsAt <= X-Server-Time, descending startsAt. all: ascending startsAt. Equal starts use ascending opaque id.",
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["upcoming", "past", "all"] },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Бронирования выбранного периода",
            "headers": {
              "X-Server-Time": {
                "required": true,
                "description": "Authoritative UTC server time of this successful read. Owner classification and last successful-load display use this instant; refresh explicitly to update it.",
                "schema": { "$ref": "#/components/schemas/UtcInstant" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bookings" }
              }
            }
          },
          "400": {
            "description": "Ошибка чтения",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "500": {
            "description": "Ошибка чтения",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "503": {
            "description": "Ошибка чтения",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Проверить здоровье сервиса",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Availability": {
        "type": "object",
        "required": [
          "eventTypeId",
          "date",
          "timeZone",
          "firstDate",
          "lastDate",
          "asOf",
          "slots"
        ],
        "properties": {
          "eventTypeId": { "type": "string", "minLength": 1 },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "timeZone": { "type": "string", "enum": ["Europe/Moscow"] },
          "firstDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "lastDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "asOf": { "type": "string", "pattern": "Z$", "format": "date-time" },
          "slots": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Slot" }
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "AvailabilityResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Availability" }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "eventType",
          "startsAt",
          "endsAt",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "eventType": { "$ref": "#/components/schemas/EventType" },
          "startsAt": {
            "type": "string",
            "pattern": "Z$",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "pattern": "Z$",
            "format": "date-time"
          },
          "guestName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=\\S)[^\\r\\n\\u2028\\u2029]*\\S$|^\\S$"
          },
          "guestEmail": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "BookingDraft": {
        "type": "object",
        "required": ["eventTypeId", "startsAt", "guestName", "guestEmail"],
        "properties": {
          "eventTypeId": { "type": "string", "minLength": 1 },
          "startsAt": {
            "type": "string",
            "pattern": "Z$",
            "format": "date-time"
          },
          "guestName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=\\S)[^\\r\\n\\u2028\\u2029]*\\S$|^\\S$"
          },
          "guestEmail": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "BookingError404": {
        "type": "object",
        "required": ["idempotencyKey", "outcome", "error"],
        "properties": {
          "idempotencyKey": { "type": "string", "format": "uuid" },
          "outcome": { "type": "string", "enum": ["rejected"] },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "enum": ["EVENT_TYPE_NOT_FOUND"] },
              "message": { "type": "string", "minLength": 1 },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/NonEmptyString"
                }
              }
            },
            "required": ["code", "message"],
            "unevaluatedProperties": { "not": {} }
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "BookingError409": {
        "oneOf": [
          { "$ref": "#/components/schemas/WriteError409" },
          { "$ref": "#/components/schemas/BookingRefusal409" }
        ]
      },
      "BookingError422": {
        "type": "object",
        "required": ["idempotencyKey", "outcome", "error"],
        "properties": {
          "idempotencyKey": { "type": "string", "format": "uuid" },
          "outcome": { "type": "string", "enum": ["rejected"] },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": ["VALIDATION_ERROR", "TIME_UNAVAILABLE"]
              },
              "message": { "type": "string", "minLength": 1 },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/NonEmptyString"
                }
              }
            },
            "required": ["code", "message"],
            "unevaluatedProperties": { "not": {} }
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "BookingRefusal409": {
        "type": "object",
        "required": ["idempotencyKey", "outcome", "error"],
        "properties": {
          "idempotencyKey": { "type": "string", "format": "uuid" },
          "outcome": { "type": "string", "enum": ["rejected"] },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "enum": ["SLOT_TAKEN"] },
              "message": { "type": "string", "minLength": 1 },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/NonEmptyString"
                }
              }
            },
            "required": ["code", "message"],
            "unevaluatedProperties": { "not": {} }
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "Bookings": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Booking" }
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "CreateBookingInput": {
        "type": "object",
        "required": ["eventTypeId", "startsAt", "guestName", "guestEmail"],
        "properties": {
          "eventTypeId": { "type": "string" },
          "startsAt": { "type": "string" },
          "guestName": { "type": "string" },
          "guestEmail": { "type": "string" }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "CreateEventTypeInput": {
        "type": "object",
        "required": ["name", "durationMinutes"],
        "properties": {
          "name": { "type": "string" },
          "durationMinutes": { "type": "integer" },
          "description": { "type": "string" }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "CreatedBooking": {
        "type": "object",
        "required": ["idempotencyKey", "data"],
        "properties": {
          "idempotencyKey": { "type": "string", "format": "uuid" },
          "data": { "$ref": "#/components/schemas/Booking" }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "CreatedEventType": {
        "type": "object",
        "required": ["idempotencyKey", "data"],
        "properties": {
          "idempotencyKey": { "type": "string", "format": "uuid" },
          "data": { "$ref": "#/components/schemas/EventType" }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "EventType": {
        "type": "object",
        "required": ["id", "name", "durationMinutes", "displayCode"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=\\S)[^\\r\\n\\u2028\\u2029]*\\S$|^\\S$"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 540
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "displayCode": { "type": "string", "pattern": "^В-[0-9]{6,}$" }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "EventTypeDraft": {
        "type": "object",
        "required": ["name", "durationMinutes"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=\\S)[^\\r\\n\\u2028\\u2029]*\\S$|^\\S$"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 540
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "EventTypes": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EventType" }
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string", "enum": ["ok"] } },
        "unevaluatedProperties": { "not": {} }
      },
      "NonEmptyString": { "type": "string", "minLength": 1 },
      "ReadError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "INTERNAL_ERROR",
                  "TEMPORARILY_UNAVAILABLE",
                  "EVENT_TYPE_NOT_FOUND",
                  "VALIDATION_ERROR",
                  "TIME_UNAVAILABLE"
                ]
              },
              "message": { "type": "string", "minLength": 1 }
            },
            "required": ["code", "message"],
            "unevaluatedProperties": { "not": {} }
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "Slot": {
        "type": "object",
        "required": ["startsAt", "endsAt"],
        "properties": {
          "startsAt": {
            "type": "string",
            "pattern": "Z$",
            "format": "date-time"
          },
          "endsAt": { "type": "string", "pattern": "Z$", "format": "date-time" }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "UtcInstant": {
        "type": "string",
        "pattern": "Z$",
        "format": "date-time"
      },
      "WriteError": {
        "type": "object",
        "required": ["outcome", "error"],
        "properties": {
          "idempotencyKey": { "type": "string", "format": "uuid" },
          "outcome": { "type": "string", "enum": ["rejected", "unknown"] },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "IDEMPOTENCY_KEY_REUSED",
                  "INVALID_REQUEST",
                  "INTERNAL_ERROR",
                  "TEMPORARILY_UNAVAILABLE"
                ]
              },
              "message": { "type": "string", "minLength": 1 },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/NonEmptyString"
                }
              }
            },
            "required": ["code", "message"],
            "unevaluatedProperties": { "not": {} }
          }
        },
        "unevaluatedProperties": { "not": {} }
      },
      "WriteError400": {
        "type": "object",
        "required": ["outcome", "error"],
        "properties": {
          "idempotencyKey": { "type": "string", "format": "uuid" },
          "outcome": { "type": "string", "enum": ["unknown"] },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "enum": ["INVALID_REQUEST"] },
              "message": { "type": "string", "minLength": 1 },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/NonEmptyString"
                }
              }
