{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Календарь звонков — HTTP API",
    "version": "1.0.0",
    "description": "Работающие операции. Новые операции добавляются вместе с реализацией."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Проверить здоровье сервиса",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      }
    },
    "/api/event-types": {
      "get": {
        "operationId": "getEventTypes",
        "summary": "Получить типы встреч, новые первыми",
        "description": "Порядок: время создания по убыванию, затем монотонный номер создания по убыванию. Названия могут совпадать; displayCode устойчив и уникален.",
        "responses": {
          "200": {
            "description": "All meeting types, including an empty list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventTypes"
                }
              }
            },
            "headers": {
              "X-Server-Time": {
                "description": "Authoritative UTC server time of this successful read. Owner classification and last successful-load display use this instant; refresh explicitly to update it.",
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createEventType",
        "summary": "Создать тип встречи с сохранённым результатом попытки",
        "description": "Idempotency-Key — UUID. Сравниваются исходные значения JSON, порядок свойств незначим. Структурные ошибки parseable JSON с действительным ключом сохраняются как окончательный VALIDATION_ERROR. Нормализация trim явная, длина проверяется после неё. Переполненные при разборе JSON числа (например 1e400) нельзя интерпретировать: INVALID_REQUEST/unknown до регистрации попытки. rejected возвращается только после commit; технический сбой оставляет unknown. Результаты не имеют TTL.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventTypeInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created or saved successful result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedEventType"
                }
              }
            }
          },
          "400": {
            "description": "Uninterpretable request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError400"
                }
              }
            }
          },
          "409": {
            "description": "Key reused with different original data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError409"
                }
              }
            }
          },
          "422": {
            "description": "Saved validation refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError422"
                }
              }
            }
          },
          "500": {
            "description": "Unknown technical outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError500"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable; unknown outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError503"
                }
              }
            }
          }
        }
      }
    },
    "/api/availability": {
      "get": {
        "operationId": "getAvailability",
        "summary": "Получить свободные интервалы по московскому времени",
        "description": "Сегодня и следующие 13 московских дней; будни 09:00–18:00, начала через 30 минут строго после asOf. Чтение не резервирует время.",
        "parameters": [
          {
            "name": "eventTypeId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete available intervals and authoritative Moscow calendar boundaries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "404": {
            "description": "Unknown event type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid date or outside availability horizon",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      }
    },
    "/api/owner/bookings": {
      "get": {
        "operationId": "getOwnerBookings",
        "summary": "Бронирования владельца календаря",
        "description": "Whole saved history, independent of the guest horizon. Default upcoming: endsAt > X-Server-Time, ascending startsAt. past: endsAt <= X-Server-Time, descending startsAt. all: ascending startsAt. Equal starts use ascending opaque id.",
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["upcoming", "past", "all"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Бронирования выбранного периода",
            "headers": {
              "X-Server-Time": {
                "description": "Authoritative UTC server time of this successful read. Owner classification and last successful-load display use this instant; refresh explicitly to update it.",
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookings"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка чтения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "500": {
            "description": "Ошибка чтения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "Ошибка чтения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "post": {
        "operationId": "createBooking",
        "summary": "Подтвердить бронирование с безопасным повтором",
        "description": "Idempotency-Key — UUID. Сравниваются исходные значения JSON, порядок свойств незначим. Структурные ошибки parseable JSON с действительным ключом сохраняются как окончательный VALIDATION_ERROR. Нормализация trim явная, длина проверяется после неё. Переполненные при разборе JSON числа (например 1e400) нельзя интерпретировать: INVALID_REQUEST/unknown до регистрации попытки. rejected возвращается только после commit; технический сбой оставляет unknown. Результаты не имеют TTL.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedBooking"
                }
              }
            }
          },
          "400": {
            "description": "Uninterpretable request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError400"
                }
              }
            }
          },
          "409": {
            "description": "Saved slot conflict or unknown reused key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError409"
                }
              }
            }
          },
          "422": {
            "description": "Saved result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError422"
                }
              }
            }
          },
          "500": {
            "description": "Unknown technical outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError500"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable; unknown outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError503"
                }
              }
            }
          },
          "404": {
            "description": "Saved result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError404"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          }
        }
      },
      "EventType": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "durationMinutes", "displayCode"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=\\S)[^\\r\\n\\u2028\\u2029]*\\S$|^\\S$"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 540
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "displayCode": {
            "type": "string",
            "pattern": "^В-[0-9]{6,}$"
          }
        }
      },
      "EventTypes": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventType"
            }
          }
        }
      },
      "ReadError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "INTERNAL_ERROR",
                  "TEMPORARILY_UNAVAILABLE",
                  "EVENT_TYPE_NOT_FOUND",
                  "VALIDATION_ERROR",
                  "TIME_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "CreateEventTypeInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["name", "durationMinutes"]
      },
      "EventTypeDraft": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=\\S)[^\\r\\n\\u2028\\u2029]*\\S$|^\\S$"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 540
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        },
        "required": ["name", "durationMinutes"]
      },
      "CreatedEventType": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/EventType"
          }
        },
        "required": ["idempotencyKey", "data"]
      },
      "WriteError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": ["rejected", "unknown"]
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "IDEMPOTENCY_KEY_REUSED",
                  "INVALID_REQUEST",
                  "INTERNAL_ERROR",
                  "TEMPORARILY_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome"]
      },
      "WriteError400": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "unknown"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "INVALID_REQUEST"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome"]
      },
      "WriteError409": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "unknown"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "IDEMPOTENCY_KEY_REUSED"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome", "idempotencyKey"]
      },
      "WriteError422": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "rejected"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome", "idempotencyKey"]
      },
      "WriteError500": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "unknown"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "INTERNAL_ERROR"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome"]
      },
      "WriteError503": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "unknown"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "TEMPORARILY_UNAVAILABLE"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome"]
      },
      "Slot": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startsAt", "endsAt"],
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      },
      "Availability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventTypeId",
          "date",
          "timeZone",
          "firstDate",
          "lastDate",
          "asOf",
          "slots"
        ],
        "properties": {
          "eventTypeId": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "timeZone": {
            "type": "string",
            "const": "Europe/Moscow"
          },
          "firstDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "lastDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "asOf": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          }
        }
      },
      "AvailabilityResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Availability"
          }
        }
      },
      "Booking": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "eventType",
          "startsAt",
          "endsAt",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "eventType": {
            "$ref": "#/components/schemas/EventType"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "guestName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=\\S)[^\\r\\n\\u2028\\u2029]*\\S$|^\\S$"
          },
