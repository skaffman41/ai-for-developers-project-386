{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Календарь звонков — HTTP API",
    "version": "1.0.0",
    "description": "Работающие операции. Новые операции добавляются вместе с реализацией."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Проверить здоровье сервиса",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      }
    },
    "/api/event-types": {
      "get": {
        "operationId": "getEventTypes",
        "summary": "Получить типы встреч, новые первыми",
        "description": "Порядок: время создания по убыванию, затем монотонный номер создания по убыванию. Названия могут совпадать; displayCode устойчив и уникален.",
        "responses": {
          "200": {
            "description": "All meeting types, including an empty list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventTypes"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createEventType",
        "summary": "Создать тип встречи с сохранённым результатом попытки",
        "description": "Idempotency-Key — UUID. Сравниваются исходные значения JSON, порядок свойств незначим. Структурные ошибки parseable JSON с действительным ключом сохраняются как окончательный VALIDATION_ERROR. Нормализация trim явная, длина проверяется после неё. Переполненные при разборе JSON числа (например 1e400) нельзя интерпретировать: INVALID_REQUEST/unknown до регистрации попытки. rejected возвращается только после commit; технический сбой оставляет unknown. Результаты не имеют TTL.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventTypeInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created or saved successful result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedEventType"
                }
              }
            }
          },
          "400": {
            "description": "Uninterpretable request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError400"
                }
              }
            }
          },
          "409": {
            "description": "Key reused with different original data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError409"
                }
              }
            }
          },
          "422": {
            "description": "Saved validation refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError422"
                }
              }
            }
          },
          "500": {
            "description": "Unknown technical outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError500"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable; unknown outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteError503"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          }
        }
      },
      "EventType": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "durationMinutes", "displayCode"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=\\S)[^\\r\\n\\u2028\\u2029]*\\S$|^\\S$"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 540
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "displayCode": {
            "type": "string",
            "pattern": "^В-[0-9]{6,}$"
          }
        }
      },
      "EventTypes": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventType"
            }
          }
        }
      },
      "ReadError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "INTERNAL_ERROR",
                  "TEMPORARILY_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "CreateEventTypeInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["name", "durationMinutes"]
      },
      "EventTypeDraft": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=\\S)[^\\r\\n\\u2028\\u2029]*\\S$|^\\S$"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 540
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        },
        "required": ["name", "durationMinutes"]
      },
      "CreatedEventType": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/components/schemas/EventType"
          }
        },
        "required": ["idempotencyKey", "data"]
      },
      "WriteError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": ["rejected", "unknown"]
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "IDEMPOTENCY_KEY_REUSED",
                  "INVALID_REQUEST",
                  "INTERNAL_ERROR",
                  "TEMPORARILY_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome"]
      },
      "WriteError400": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "unknown"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "INVALID_REQUEST"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome"]
      },
      "WriteError409": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "unknown"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "IDEMPOTENCY_KEY_REUSED"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome", "idempotencyKey"]
      },
      "WriteError422": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "rejected"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome", "idempotencyKey"]
      },
      "WriteError500": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "unknown"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "INTERNAL_ERROR"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome"]
      },
      "WriteError503": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "const": "unknown"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "const": "TEMPORARILY_UNAVAILABLE"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error", "outcome"]
      }
    }
  }
}
