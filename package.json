{
  "name": "call-calendar",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "browser:install": "playwright install chromium",
    "typecheck": "npm run typecheck --workspaces && tsc --project tsconfig.tools.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
