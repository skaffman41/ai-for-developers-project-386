{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "scripts/*.mjs",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.mjs"
  ]
}
